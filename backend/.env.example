# =============================================================================
# ActivEducation Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# Ne JAMAIS commiter .env dans git
# =============================================================================

# Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# Supabase (obligatoire)
# =============================================================================
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
SUPABASE_JWT_SECRET=<jwt-secret>

# =============================================================================
# SECRET_KEY : signe les tokens JWT internes (reset password, sessions internes)
# Generer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Exemple de format attendu : "xK9mP2vR7qW4nJ6hT1aF8sL3dG0bY5cZ..."  (64 caracteres)
# NE PAS utiliser de JWT comme cle secrete !
# =============================================================================
SECRET_KEY=change-me-to-a-random-64-char-string-generated-with-secrets-token-urlsafe

# =============================================================================
# Redis (optionnel — fallback memoire si absent)
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# LLM — AIDA / TutorAI (cle Groq gratuite : https://console.groq.com)
# =============================================================================
GROQ_API_KEY=<groq-api-key>

# Provider et parametres de generation (defauts = comportement actuel).
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=30

# Fallback local Ollama (mode hors-ligne, auto-heberge).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=90

# TutorAI — bascule de deploiement progressif.
# Passer a true UNIQUEMENT apres avoir applique la migration 018
# (cree chat_sessions / chat_messages). Defaut false = memoire process.
TUTOR_PERSIST_SESSIONS=false
TUTOR_SESSION_HISTORY_LIMIT=20

# TutorAI RAG — recherche semantique sur le contenu de cours.
# Embeddings via Ollama (nomic-embed-text, 768d). Ollama + le modele doivent
# tourner la ou le backend embed. Passer TUTOR_RAG_ENABLED=true UNIQUEMENT
# apres avoir applique la migration 019 (pgvector + content_chunks).
TUTOR_RAG_ENABLED=false
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_SECONDS=60
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.3
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=200

# =============================================================================
# CORS (separer par virgule)
# =============================================================================
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Monitoring (optionnel)
# =============================================================================
SENTRY_DSN=

LOG_LEVEL=INFO

# =============================================================================
# Ecoles - agrement MESR
# =============================================================================
# Millesime ecrit dans schools.accreditations par
# scripts/tag_accreditation_mesr.py. A bumper a chaque rentree, en meme temps
# que docs/reference_mesr_<annee>.csv.
SCHOOLS_ACCREDITATION_LABEL=MESR 2026-2027
# true : l'annuaire public et la recherche ne renvoient que les etablissements
# agreees. Le detail d'une ecole reste accessible, et ?accredited_only=false
# permet d'obtenir la liste complete.
SCHOOLS_ACCREDITED_ONLY=true
